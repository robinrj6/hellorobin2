---
import skillsData from "../../public/data/skills.json";

type SkillGroup =
  | "ml"
  | "frontend"
  | "backend"
  | "mobile"
  | "automation"
  | "gray";

type SkillEntry = {
  name: string;
  icon: string;
  group?: SkillGroup;
};

const groupLabels: Record<SkillGroup, string> = {
  ml: "AI / ML",
  frontend: "Frontend",
  backend: "Backend",
  mobile: "Mobile",
  automation: "Automation",
  gray: "Other",
};

const groupOrder: SkillGroup[] = [
  "ml",
  "frontend",
  "backend",
  "mobile",
  "automation",
  "gray",
];

const typedSkills = skillsData as SkillEntry[];

const groupedSkills = groupOrder
  .map((group) => ({
    id: group,
    label: groupLabels[group],
    items: typedSkills.filter((skill) => (skill.group ?? "gray") === group),
  }))
  .filter((group) => group.items.length > 0);
---

<div class="section-label">Stack</div>
<div class="skills-wrap">
  <div class="clusters">
    {
      groupedSkills.map((group) => (
        <section class="cluster">
          <span class="cluster-name">{group.label}</span>

          <ul class="cluster-row">
            {group.items.map((skill) => (
              <li class="skill-item">
                <img src={skill.icon} alt={skill.name} loading="lazy" />
                <span>{skill.name}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<style>
  @property --border-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @font-face {
    font-family: "Hurmit";
    src: url("/src/assets/fonts/HurmitNerdFont-Regular.otf") format("opentype");
  }

  .skills-wrap {
    --border-angle: 0deg;
    font-family: "Hurmit", sans-serif;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 2rem 1.5rem;
    width: min(1180px, 92vw);
    margin: 0 auto 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    background:
      linear-gradient(#130609, #130609) padding-box,
      conic-gradient(
          from var(--border-angle),
          rgba(255, 255, 255, 0.08) 0deg,
          rgba(255, 255, 255, 0.08) 320deg,
          rgba(182, 82, 255, 0.95) 338deg,
          rgba(255, 255, 255, 1) 349deg,
          rgba(182, 82, 255, 0.95) 356deg,
          rgba(255, 255, 255, 0.08) 360deg
        )
        border-box;
    box-shadow: 0 0 20px rgba(182, 82, 255, 0.12);
    animation: border-flow 4s linear infinite;
  }

  @keyframes border-flow {
    to {
      --border-angle: 360deg;
    }
  }

  .section-label {
    width: min(1180px, 92vw);
    margin: 0 auto 0.35rem;
    font-size: 0.95rem;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    font-family: "Hurmit", monospace;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .clusters {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .cluster {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .cluster-name {
    width: 88px;
    flex-shrink: 0;
    padding-top: 8px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.24);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: "Hurmit", monospace;
  }

  .cluster-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: rgba(255, 255, 255, 0.62);
    background: rgba(255, 255, 255, 0.04);
    border: 0.5px solid rgba(255, 255, 255, 0.09);
    border-radius: 7px;
    padding: 6px 11px;
    position: relative;
    overflow: hidden;
    cursor: default;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .skill-item:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
    transform: translateY(-2px);
  }

  .skill-item::after {
    content: "";
    position: absolute;
    top: 0;
    left: -140%;
    width: 45%;
    height: 100%;
    background: linear-gradient(
      110deg,
      transparent 0%,
      rgba(255, 255, 255, 0.75) 50%,
      transparent 100%
    );
    transform: skewX(-20deg);
    opacity: 0;
    pointer-events: none;
  }

  .skill-item:hover::after {
    opacity: 1;
    animation: silver-flash 0.7s ease-out 1;
  }

  @keyframes silver-flash {
    0% {
      left: -140%;
    }
    100% {
      left: 140%;
    }
  }

  .skill-item span {
    font-size: 12px;
    line-height: 1;
    font-family: "Hurmit", monospace;
  }

  .skill-item img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    flex-shrink: 0;
  }

  @media screen and (max-width: 700px) {
    .skills-wrap {
      padding: 1.25rem 1rem;
      width: 94vw;
    }

    .cluster {
      flex-direction: column;
      gap: 0.55rem;
    }

    .cluster-name {
      width: auto;
      padding-top: 0;
    }
  }
</style>
